{
  "name": "ride2fde",
  "private": true,
  "version": "0.1.0",
  "description": "A ride pool for FDE Summit attendees going to IIT Hyderabad: meet before the summit.",
  "license": "MIT",
  "author": "Eshwar Vemula (https://www.veshwar.dev/)",
  "homepage": "https://ride2fde.veshwar.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eshwarsgithub/ride2fde.git"
  },
  "bugs": {
    "url": "https://github.com/eshwarsgithub/ride2fde/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p functions/tsconfig.json",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --d1=DB=4d6c00a1-507d-41f9-9063-c938e58a30ad --local",
    "db:migrate:local": "wrangler d1 migrations apply ride2fde-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ride2fde-db --remote",
    "deploy": "vite build && wrangler pages deploy dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.20.7",
    "typescript": "^5.6.2",
    "vite": "^7.3.8",
    "wrangler": "^4.168.0"
  }
}
