# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/
# Pages already serves every file from its CDN (cached until the next deploy) with ETag revalidation. These rules
# add long browser caching for files whose names never change content, so a returning visitor loads them instantly.

# Vite's build output: the file name contains a hash of the content, so a new version gets a new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Map data (npm run map:assets) lives under a dated version folder, so it's just as safe to cache for a year.
/map/*
  Cache-Control: public, max-age=31536000, immutable

# Vector tiles and label fonts are protobuf. Naming the type lets Cloudflare compress them on the way out
# (application/x-protobuf is on its compression list; the .pbf extension alone would be sent uncompressed).
/map/:version/tiles/*
  Content-Type: application/x-protobuf

/map/:version/fonts/*
  Content-Type: application/x-protobuf

/favicon.svg
  Cache-Control: public, max-age=86400
